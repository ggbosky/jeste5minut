<section class="mx-auto flex min-h-svh max-w-[30rem] flex-col items-center justify-center px-5 py-16 text-center">
  <p class="text-2xl">{% render 'logo' %}</p>
  {%- if shop.password_message != blank -%}
    <p class="mt-6 text-lg text-muted">{{ shop.password_message }}</p>
  {%- endif -%}
  {%- form 'storefront_password', class: 'mt-8 flex w-full flex-col gap-3 sm:flex-row' -%}
    <label for="password" class="sr-only">Heslo</label>
    <input id="password" type="password" name="password" required class="min-h-12 w-full rounded-full border border-line px-5" placeholder="Heslo">
    <button type="submit" class="btn btn-dark">Vstoupit</button>
    {%- if form.errors -%}
      <p class="text-sm text-coral-text sm:basis-full">Heslo nesedí.</p>
    {%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{ "name": "Heslo" }
{% endschema %}
