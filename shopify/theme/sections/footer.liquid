{%- comment -%}
  Patička: logo + odkazy na zásady napsané v Shopify (Nastavení → Zásady).
  Odkazy jsou napevno česky (snippets/policy-label.liquid). Zásada, kterou v Shopify nemáš zveřejněnou,
  vede na „stránka nenalezena“ – buď ji zveřejni, nebo odkaz vypni v nastavení patičky.
  Volitelně můžeš přidat menu (Online Store → Navigace) s dalšími odkazy, např. na stránku Kontakt.
{%- endcomment -%}
<footer class="site-footer border-t border-line py-10 text-sm text-muted">
  <div class="container-page flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <p class="text-ink">{% render 'logo' %}</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {%- assign handles = 'refund-policy,privacy-policy,terms-of-service,shipping-policy,contact-information,legal-notice' | split: ',' -%}
      {%- for handle in handles -%}
        {%- assign key = 'show_' | append: handle | replace: '-', '_' -%}
        {%- if section.settings[key] -%}
          <li>
            <a href="{{ routes.root_url | append: '/policies/' | replace: '//', '/' }}{{ handle }}" class="hover:text-ink">
              {%- render 'policy-label', handle: handle -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}" class="hover:text-ink">{{ link.title | escape }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
  <p class="container-page mt-6">© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
</footer>

{% schema %}
{
  "name": "Patička",
  "class": "section-footer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Odkazy na zásady ze Shopify (Nastavení → Zásady). Každá zásada musí být v Shopify zveřejněná, jinak odkaz vede na „stránka nenalezena“."
    },
    { "type": "checkbox", "id": "show_refund_policy", "label": "Zásady vracení peněz", "default": true },
    { "type": "checkbox", "id": "show_privacy_policy", "label": "Ochrana osobních údajů", "default": true },
    { "type": "checkbox", "id": "show_terms_of_service", "label": "Obchodní podmínky", "default": true },
    { "type": "checkbox", "id": "show_shipping_policy", "label": "Doručení", "default": true },
    { "type": "checkbox", "id": "show_contact_information", "label": "Kontaktní údaje", "default": true },
    { "type": "checkbox", "id": "show_legal_notice", "label": "Právní upozornění", "default": true },
    { "type": "link_list", "id": "menu", "label": "Další odkazy (menu)", "info": "Nepovinné." }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
