<section class="page-wrap max-w-[44rem]">
  <h1 class="section-title">{{ blog.title | escape }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="mt-10 grid gap-6">
      {%- for article in blog.articles -%}
        <li>
          <a href="{{ article.url }}" class="text-xl font-semibold hover:underline">{{ article.title | escape }}</a>
          <p class="mt-1 text-sm text-muted">{{ article.published_at | date: '%-d. %-m. %Y' }}</p>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      <div class="mt-10">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Blog" }
{% endschema %}
