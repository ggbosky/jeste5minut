<section id="{{ section.settings.anchor | remove: '#' | default: section.id }}" class="bg-ink py-20 text-white sm:py-28" aria-labelledby="faq-{{ section.id }}">
  <div class="container-page">
    <h2 id="faq-{{ section.id }}" class="section-title text-center" data-reveal>{{ section.settings.title }}</h2>
    <div class="mx-auto mt-12 grid max-w-[48rem] gap-3">
      {%- for block in section.blocks -%}
        <details class="faq" name="faq" data-reveal {{ block.shopify_attributes }}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-lg font-medium">
            <span>{{ block.settings.question | escape }}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer max-w-[40rem] px-6 pb-6 leading-relaxed text-white/70">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .faq {
    border-radius: 18px;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    transition: background-color 0.25s;
  }
  .faq:hover,
  .faq[open] {
    background: rgb(255 255 255 / 0.09);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    transition:
      rotate 0.3s var(--ease-out-expo),
      background-color 0.25s;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 12px;
    height: 1.5px;
    translate: -50% -50%;
    background: currentColor;
  }
  .faq-icon::after {
    rotate: 90deg;
  }
  .faq[open] .faq-icon {
    rotate: 45deg;
    background: var(--color-coral);
    color: var(--color-ink);
  }
  .faq-answer a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq[open] .faq-answer {
      animation: faq-in 0.35s var(--ease-out-expo);
    }
  }
  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Časté otázky",
  "max_blocks": 20,
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Nadpis", "default": "Časté otázky" },
    { "type": "text", "id": "anchor", "label": "Kotva sekce", "default": "faq", "info": "Na tuhle sekci odkazuje lišta nahoře (#faq)." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Otázka",
      "settings": [
        { "type": "text", "id": "question", "label": "Otázka", "default": "Otázka" },
        { "type": "richtext", "id": "answer", "label": "Odpověď", "default": "<p>Odpověď</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Časté otázky" }]
}
{% endschema %}
