{%- comment -%}
  Ikony. Použití: {% render 'icon', name: 'check', size: 18 %}
  name: check | arrow | download | shield
{%- endcomment -%}
{%- assign s = size | default: 18 -%}
{%- case name -%}
  {%- when 'check' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="{{ class }}"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="{{ stroke | default: 2.5 }}" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'arrow' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="{{ class }}"><path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'download' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'shield' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m8.8 12 2.3 2.3 4.2-4.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcase -%}
