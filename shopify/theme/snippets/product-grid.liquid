{%- comment -%} Mřížka produktů. Parametr: products {%- endcomment -%}
<ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {%- for p in products -%}
    <li>
      <a href="{{ p.url }}" class="group block overflow-hidden rounded-3xl border border-line bg-paper transition-shadow hover:shadow-[0_18px_40px_-20px_rgb(20_33_61/0.35)]">
        <div class="aspect-[4/3] overflow-hidden bg-soft">
          {%- if p.featured_media -%}
            {{ p.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', class: 'h-full w-full object-cover', alt: p.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'h-full w-full' }}
          {%- endif -%}
        </div>
        <div class="p-6">
          <h2 class="text-lg font-semibold tracking-tight">{{ p.title | escape }}</h2>
          <p class="mt-2 font-semibold">{{ p.price | money_without_trailing_zeros }}</p>
        </div>
      </a>
    </li>
  {%- endfor -%}
</ul>
