---
import { getContent } from '../content';

const t = getContent();
---

<header id="nav" class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300">
  <nav class="container-page flex h-14 items-center justify-between gap-6" aria-label={t.nav.ariaLabel}>
    <a href="#top" class="font-semibold tracking-tight" aria-label={t.nav.logoLabel}>Ještě 5 minut</a>
    <div class="flex items-center gap-6 text-[0.9375rem]">
      <ul class="hidden items-center gap-6 sm:flex">
        {
          t.nav.links.map((l) => (
            <li>
              <a href={l.href} class="text-muted transition-colors hover:text-ink">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#cena" class="btn btn-sm">{t.nav.cta}</a>
    </div>
  </nav>
</header>

<style>
  #nav.is-stuck {
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    border-bottom-color: var(--color-line);
  }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const onScroll = () => nav.classList.toggle('is-stuck', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
