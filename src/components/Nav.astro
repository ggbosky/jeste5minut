---
import Logo from './Logo.astro';
import { getContent } from '../content';

const t = getContent();
---

<!-- Nahoře průhledná přes video hera, po scrollu se z ní stane plovoucí „pilulka“ -->
<header id="nav" class="fixed inset-x-0 top-0 z-50">
  <nav class="nav-shell" aria-label={t.nav.ariaLabel}>
    <a href="#top" class="nav-logo text-[1.0625rem]" aria-label={t.nav.logoLabel}><Logo /></a>
    <div class="flex items-center gap-2 sm:gap-3">
      <ul class="hidden items-center gap-1 sm:flex">
        {
          t.nav.links.map((l) => (
            <li>
              <a href={l.href} class="nav-link">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#cena" class="btn btn-sm btn-arrow nav-cta" data-track="cta_nav">
        {t.nav.cta}
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  #nav {
    padding-top: 0;
    transition: padding 0.5s var(--ease-out-expo);
  }
  .nav-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4rem;
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
    padding-inline: max(1.25rem, env(safe-area-inset-left, 0px));
    border-radius: 999px;
    color: #fff;
    --logo-hands: #fff;
    transition:
      max-width 0.5s var(--ease-out-expo),
      height 0.5s var(--ease-out-expo),
      padding 0.5s var(--ease-out-expo),
      background-color 0.3s,
      box-shadow 0.3s,
      color 0.3s;
  }
  .nav-link {
    display: block;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgb(255 255 255 / 0.78);
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .nav-link:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.12);
  }
  /* na tmavém videu se tlačítko při najetí přelije do bíla, na bílé liště do modré */
  .nav-cta {
    --btn-fill: #fff;
    --btn-fill-text: var(--color-ink);
    padding-inline: 1.1rem 0.95rem;
    box-shadow: 0 6px 18px -8px rgb(251 103 32 / 0.8);
  }
  .nav-cta:hover {
    box-shadow: none;
  }

  /* po scrollu: plovoucí bílá pilulka se stínem */
  #nav.is-stuck {
    padding-top: 0.625rem;
  }
  #nav.is-stuck .nav-shell {
    width: calc(100% - 1.25rem);
    max-width: 58rem;
    height: 3.5rem;
    padding-inline: 1.25rem 0.5rem;
    color: var(--color-ink);
    --logo-hands: #4d4d4d;
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: saturate(1.8) blur(18px);
    box-shadow:
      0 0 0 1px rgb(20 33 61 / 0.07),
      0 12px 32px -12px rgb(20 33 61 / 0.28);
  }
  #nav.is-stuck .nav-cta {
    --btn-fill: var(--color-ink);
    --btn-fill-text: #fff;
  }
  #nav.is-stuck .nav-link {
    color: var(--color-muted);
  }
  #nav.is-stuck .nav-link:hover {
    color: var(--color-ink);
    background: var(--color-soft);
  }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const onScroll = () => nav.classList.toggle('is-stuck', scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
