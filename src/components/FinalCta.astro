---
import { pricing } from '../../site.config';
import { getContent } from '../content';
import { czk, currentPrice } from '../lib/format';
import { rich } from '../lib/rich';

const f = getContent().finalCta;
const price = czk(currentPrice(pricing.basic));
---

<section id="start" class="relative bg-coral py-20 text-ink sm:py-28 lg:py-32" aria-labelledby="final-title">
  <div class="mx-auto grid max-w-[90rem] gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:items-end lg:px-10">
    <h2 id="final-title" class="lg:col-span-8">
      <span class="display-md block" data-reveal set:html={rich(f.title[0])} />
      <span class="display-xl block" data-reveal style="--i:1" set:html={rich(f.title[1])} />
    </h2>

    <div class="flex flex-col items-start gap-5 lg:col-span-4 lg:pb-4" data-reveal style="--i:2">
      <p class="max-w-[22rem] text-lg leading-snug font-medium" set:html={rich(f.text)} />
      <a href="#cena" class="btn btn-lg btn-ink" data-magnetic="0.3" data-track="cta_final">
        {f.cta}
        <span class="font-mono text-[0.85em] font-normal">· {price}</span>
      </a>
    </div>
  </div>
</section>
