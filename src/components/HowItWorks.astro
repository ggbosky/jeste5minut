---
import { getContent } from '../content';
import { rich } from '../lib/rich';

const h = getContent().how;
---

<section class="relative bg-ink py-20 text-paper sm:py-28 lg:py-32" aria-labelledby="how-title">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-10">
    <h2 id="how-title" class="display-md max-w-[18ch]" data-reveal style="--i:1" set:html={rich(h.title)} />

    <ol class="mt-14 grid gap-5 lg:mt-20 lg:grid-cols-3 lg:gap-6">
      {
        h.steps.map((s, n) => (
          <li class="step relative border-t border-paper/25 pt-6" data-reveal style={`--i:${n}`}>
            <span class="step-n font-mono" aria-hidden="true">
              {n + 1} / {h.steps.length}
            </span>
            <h3 class="mt-5 text-[2.25rem] leading-[0.95] sm:text-5xl" set:html={rich(s.title)} />
            <p class="mt-4 text-lg leading-relaxed text-paper/80" set:html={rich(s.text)} />
            {n < h.steps.length - 1 && (
              <svg class="step-arrow hidden lg:block" width="44" height="24" viewBox="0 0 44 24" fill="none" aria-hidden="true">
                <path d="M2 12h36m0 0-9-9m9 9-9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .step-n {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: var(--color-coral);
  }
  .step-arrow {
    position: absolute;
    right: 0;
    top: 1.4rem;
    z-index: 1;
    color: var(--color-coral);
  }
</style>
