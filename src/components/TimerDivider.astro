---
/** Dělítko sekcí stylizované jako stupnice stopek. */
interface Props {
  label?: string;
  class?: string;
}
const { label, class: cls = '' } = Astro.props;
---

<div class:list={['mx-auto flex max-w-[90rem] items-end gap-4 px-4 sm:px-6 lg:px-10', cls]} aria-hidden="true">
  {label && <span class="font-mono text-sm leading-none tabular-nums">{label}</span>}
  <div class="ticks flex-1 opacity-80"></div>
</div>
