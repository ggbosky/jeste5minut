---
import { pricing } from '../../site.config';
import { getContent } from '../content';
import { czk, currentPrice } from '../lib/format';
import { rich } from '../lib/rich';

const h = getContent().hero;
const now = currentPrice(pricing.basic);
const discount = pricing.basic.launch ? Math.round((1 - pricing.basic.launch / pricing.basic.regular) * 100) : 0;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="top" class="hero relative isolate overflow-clip text-white">
  <!-- Video v pozadí (bez zvuku, ve smyčce). S omezeným pohybem zůstane jen první snímek. -->
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={`${base}/video/hero-poster.webp`}
    aria-label={h.videoLabel}
    data-hero-video
  >
    <source src={`${base}/video/hero.webm`} type="video/webm" />
    <source src={`${base}/video/hero.mp4`} type="video/mp4" />
  </video>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container-page relative pt-16 pb-20 sm:pt-24 sm:pb-28 lg:pt-28 lg:pb-32">
    <div class="max-w-[44rem]">
      <!-- Výmluvy se postupně přeškrtnou, zůstane „teď.“ (bez JS / s omezeným pohybem rovnou „teď.“) -->
      <h1 class="hero-title" aria-label={`${h.lead} ${h.now}`}>
        <span class="block" aria-hidden="true">{h.lead}</span>
        <span class="swap" aria-hidden="true" data-swap>
          {h.excuses.map((w) => <span class="w">{w}</span>)}
          <span class="w w-now">{h.now}</span>
        </span>
      </h1>

      <p class="hero-in mt-7 text-2xl font-semibold tracking-tight sm:text-3xl" style="--d:150ms">{h.subtitle}</p>

      <ul class="hero-in mt-6 grid gap-2.5" style="--d:290ms">
        {
          h.points.map((p: string) => (
            <li class="flex items-center gap-3 text-[1.0625rem]">
              <span class="grid size-6 shrink-0 place-items-center rounded-full bg-coral text-ink" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
                  <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span set:html={rich(p)} />
            </li>
          ))
        }
      </ul>

      <!-- Cena samostatně a velká, tlačítka pod ní čistá -->
      <div class="hero-in mt-10 flex items-end gap-4" style="--d:340ms">
        <span class="price-now">{czk(now)}</span>
        {
          pricing.basic.launch && (
            <span class="pb-1.5 leading-tight">
              <s class="block text-white/60">{czk(pricing.basic.regular)}</s>
              <span class="block text-sm font-semibold text-coral">
                −{discount} % {h.discountLabel}
              </span>
            </span>
          )
        }
      </div>

      <div class="hero-in mt-5 flex flex-col gap-3 sm:flex-row" style="--d:380ms">
        <a href="#cena" class="cta-main" data-track="cta_hero">
          <span class="cta-shine" aria-hidden="true"></span>
          {h.buy}
          <svg class="cta-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <p class="hero-in mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-white/75" style="--d:420ms">
        <span class="inline-flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {h.ctaNote}
        </span>
        {
          h.trust.map((x: string, i: number) => (
            <span class="inline-flex items-center gap-1.5">
              {i === 0 ? (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                  <path d="m8.8 12 2.3 2.3 4.2-4.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              ) : (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {x}
            </span>
          ))
        }
      </p>
    </div>
  </div>
</section>

<style>
  .hero-title {
    font-size: clamp(3.75rem, 16vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  @media (min-width: 1024px) {
    .hero-title {
      font-size: min(8.4vw, 7.5rem);
    }
  }
  .swap {
    display: inline-grid;
    justify-items: start;
  }
  .w {
    grid-area: 1 / 1;
    position: relative;
    white-space: nowrap;
    opacity: 0;
    transition:
      opacity 0.45s ease,
      transform 0.6s var(--ease-out-expo),
      color 0.3s;
  }
  /* škrtnutí */
  .w::after {
    content: '';
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    top: 54%;
    height: 0.07em;
    border-radius: 0.04em;
    background: var(--color-coral);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out-expo);
  }
  .w.is-struck {
    color: rgb(255 255 255 / 0.55);
  }
  .w.is-struck::after {
    transform: scaleX(1);
  }
  .w.is-active {
    opacity: 1;
  }
  .w.is-leaving {
    opacity: 0;
    transform: translateY(-0.35em);
  }
  .w.is-entering {
    transform: translateY(0.35em);
  }
  .w-now {
    color: var(--color-coral);
  }
  .w-now::after {
    display: none;
  }

  /* s JS je od prvního vykreslení vidět první výmluva (žádné prázdné místo, než se skript načte) */
  :global(html.js) .w:first-child:not(.is-leaving) {
    opacity: 1;
  }
  /* bez JS nebo s omezeným pohybem: rovnou finální „teď.“ */
  :global(html:not(.js)) .w-now {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .w {
      opacity: 0 !important;
    }
    .w-now {
      opacity: 1 !important;
    }
  }

  /* ---------- video v pozadí ---------- */
  .hero {
    background: var(--color-ink);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(20 33 61 / 0.92) 0%, rgb(20 33 61 / 0.78) 45%, rgb(20 33 61 / 0.35) 100%),
      linear-gradient(0deg, rgb(20 33 61 / 0.6), transparent 40%);
  }
  @media (max-width: 767px) {
    .hero-shade {
      background: rgb(20 33 61 / 0.82);
    }
  }

  /* ---------- cena ---------- */
  .price-now {
    font-size: clamp(2.75rem, 9vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  /* ---------- hlavní CTA ---------- */
  .cta-main {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 4rem;
    padding: 0.8rem 2.25rem;
    border-radius: 999px;
    background: var(--color-coral);
    color: var(--color-ink);
    font-size: 1.2rem;
    font-weight: 700;
    box-shadow:
      0 10px 30px -8px rgb(251 103 32 / 0.65),
      inset 0 1px 0 rgb(255 255 255 / 0.35);
    transition:
      transform 0.2s var(--ease-out-expo),
      box-shadow 0.3s,
      background-color 0.2s;
  }
  .cta-main:hover {
    transform: translateY(-2px);
    background: #ff7a3a;
    box-shadow:
      0 16px 40px -8px rgb(251 103 32 / 0.8),
      inset 0 1px 0 rgb(255 255 255 / 0.35);
  }
  .cta-main:active {
    transform: translateY(0) scale(0.98);
  }
  .cta-arrow {
    transition: transform 0.3s var(--ease-out-expo);
  }
  .cta-main:hover .cta-arrow {
    transform: translateX(4px);
  }
  /* lesk, který občas přejede přes tlačítko a přitáhne pohled */
  .cta-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 35%, rgb(255 255 255 / 0.45) 50%, transparent 65%);
    transform: translateX(-120%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta-shine {
      animation: shine 4.5s ease-in-out 2.5s infinite;
    }
  }
  @keyframes shine {
    0% {
      transform: translateX(-120%);
    }
    25%,
    100% {
      transform: translateX(120%);
    }
  }

  /* úvodní najetí textu (jen posun, nic se neskrývá → nezdržuje LCP) */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 0.9s var(--ease-out-expo) both;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes hero-in {
    from {
      transform: translateY(18px);
    }
  }
</style>

<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1) Výmluvy se postupně přeškrtnou
  const swap = document.querySelector<HTMLElement>('[data-swap]');
  if (swap && !calm) {
    const words = [...swap.querySelectorAll<HTMLElement>('.w')];
    let i = 0;
    words[0].classList.add('is-active');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      await wait(700);
      while (i < words.length - 1) {
        const cur = words[i];
        const next = words[i + 1];
        cur.classList.add('is-struck');
        await wait(500);
        next.classList.add('is-entering');
        void next.offsetWidth;
        cur.classList.add('is-leaving');
        cur.classList.remove('is-active');
        next.classList.add('is-active');
        next.classList.remove('is-entering');
        i++;
        await wait(i === words.length - 1 ? 0 : 750);
      }
    })();
  }

  // 2) S omezeným pohybem video nehraje (zůstane první snímek)
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && calm) {
    video.removeAttribute('autoplay');
    video.pause();
  }
</script>
