---
import { pricing } from '../../site.config';
import { getContent } from '../content';
import { czk, currentPrice } from '../lib/format';
import { rich } from '../lib/rich';

const h = getContent().hero;
const now = currentPrice(pricing.basic);
---

<section id="top" class="overflow-clip pt-16 pb-24 text-center sm:pt-28 sm:pb-36">
  <div class="container-page">
    <!-- Výmluvy se postupně přeškrtnou, zůstane „teď.“ (bez JS / s omezeným pohybem rovnou „teď.“) -->
    <h1 class="hero-title" aria-label={`${h.lead} ${h.now}`}>
      <span class="block" aria-hidden="true">{h.lead}</span>
      <span class="swap" aria-hidden="true" data-swap>
        {h.excuses.map((w) => <span class="w">{w}</span>)}
        <span class="w w-now">{h.now}</span>
      </span>
    </h1>

    <p class="hero-in mx-auto mt-8 max-w-[34rem] text-lg leading-relaxed text-muted sm:text-xl" style="--d:200ms" set:html={rich(h.text)} />

    <div class="hero-in mt-8 flex flex-col items-center gap-4" style="--d:300ms">
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-3">
        <span class="text-2xl font-semibold tracking-tight">{czk(now)}</span>
        {
          pricing.basic.launch && (
            <span class="text-muted">
              {h.regularLabel} <s>{czk(pricing.basic.regular)}</s>
            </span>
          )
        }
        <a href="#cena" class="btn btn-lg" data-track="cta_hero">{h.buy}</a>
      </div>
      <p class="text-[0.9375rem] text-muted">{h.facts.map((f) => `${f.value} ${f.label}`).join(' · ')}</p>
      <a href="#sos-karta" class="link text-[0.9375rem] text-muted">{h.free}</a>
    </div>

  </div>
</section>

<style>
  .hero-title {
    font-size: clamp(3.75rem, 16vw, 9.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .swap {
    display: inline-grid;
    justify-items: center;
  }
  .w {
    grid-area: 1 / 1;
    position: relative;
    white-space: nowrap;
    opacity: 0;
    transition:
      opacity 0.45s ease,
      transform 0.6s var(--ease-out-expo),
      color 0.3s;
  }
  /* škrtnutí */
  .w::after {
    content: '';
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    top: 54%;
    height: 0.07em;
    border-radius: 0.04em;
    background: var(--color-coral);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out-expo);
  }
  .w.is-struck {
    color: color-mix(in srgb, var(--color-ink) 50%, white);
  }
  .w.is-struck::after {
    transform: scaleX(1);
  }
  .w.is-active {
    opacity: 1;
  }
  .w.is-leaving {
    opacity: 0;
    transform: translateY(-0.35em);
  }
  .w.is-entering {
    transform: translateY(0.35em);
  }
  .w-now {
    color: var(--color-coral);
  }
  .w-now::after {
    display: none;
  }

  /* s JS je od prvního vykreslení vidět první výmluva (žádné prázdné místo, než se skript načte) */
  :global(html.js) .w:first-child:not(.is-leaving) {
    opacity: 1;
  }
  /* bez JS nebo s omezeným pohybem: rovnou finální „teď.“ */
  :global(html:not(.js)) .w-now {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .w {
      opacity: 0 !important;
    }
    .w-now {
      opacity: 1 !important;
    }
  }

  /* úvodní najetí textu pod nadpisem (jen posun, nic se neskrývá → nezdržuje LCP) */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 0.9s var(--ease-out-expo) both;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes hero-in {
    from {
      transform: translateY(18px);
    }
  }

</style>

<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1) Výmluvy se postupně přeškrtnou
  const swap = document.querySelector<HTMLElement>('[data-swap]');
  if (swap && !calm) {
    const words = [...swap.querySelectorAll<HTMLElement>('.w')];
    let i = 0;
    words[0].classList.add('is-active');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      await wait(900);
      while (i < words.length - 1) {
        const cur = words[i];
        const next = words[i + 1];
        cur.classList.add('is-struck');
        await wait(550);
        next.classList.add('is-entering');
        void next.offsetWidth;
        cur.classList.add('is-leaving');
        cur.classList.remove('is-active');
        next.classList.add('is-active');
        next.classList.remove('is-entering');
        i++;
        await wait(i === words.length - 1 ? 0 : 1000);
      }
    })();
  }

</script>
