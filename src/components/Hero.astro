---
import SnoozeAlarm from './SnoozeAlarm.astro';
import { pricing } from '../../site.config';
import { getContent } from '../content';
import { czk, currentPrice } from '../lib/format';
import { nbsp, rich } from '../lib/rich';

const t = getContent();
const h = t.hero;
const price = czk(currentPrice(pricing.basic));
// „5“ v nadpisu dostane vlastní ciferník, zbytek je čistý text
const [line1, line2] = h.title.map((l) => nbsp(l));
const line1Html = line1.replace(/\b5\b/, '<span class="hero-five" aria-hidden="true">5</span><span class="sr-only">5</span>');
---

<section id="top" class="relative overflow-clip pt-24 pb-16 sm:pt-28 lg:pt-28 lg:pb-24">
  <div class="mx-auto grid max-w-[90rem] gap-14 px-4 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:px-10">
    <div class="lg:col-span-7">
      <p class="kicker hero-in mb-5 sm:mb-7"><span set:html={rich(h.eyebrow)} /></p>

      <h1>
        <span class="hero-l1 block hero-in" style="--i:1" set:html={line1Html} />
        <span class="hero-line2 mt-2 block sm:mt-3 hero-in" style="--i:2">{line2}</span>
      </h1>

      <p class="mt-8 max-w-[34rem] text-lg leading-relaxed sm:mt-10 sm:text-xl hero-in" style="--i:3" set:html={rich(h.subline)} />

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center hero-in" style="--i:4">
        <a href="#cena" class="btn btn-lg btn-coral" data-magnetic="0.3" data-track="cta_hero">
          {h.primaryCta}
          <span class="font-mono text-[0.85em] font-normal">· {price}</span>
        </a>
        <a href="#sos-karta" class="btn btn-lg" data-track="lead_hero">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3v12m0 0-5-5m5 5 5-5M4 20h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          {h.secondaryCta}
        </a>
      </div>

      <p class="mt-6 max-w-[30rem] text-[0.9375rem] leading-snug text-ink/70 hero-in" style="--i:5" set:html={rich(h.trust)} />
    </div>

    <div class="relative lg:col-span-5 lg:pt-2">
      <SnoozeAlarm />
    </div>
  </div>
</section>

<style is:global>
  .hero-l1 {
    font-size: clamp(4rem, 17vw, 11.5rem);
    line-height: 0.9;
  }
  @media (min-width: 1024px) {
    .hero-l1 {
      font-size: min(9.4vw, 9.5rem);
    }
  }
  .hero-line2 {
    font-size: clamp(2.6rem, 10vw, 7rem);
    line-height: 0.9;
    max-width: 12ch;
  }
  @media (min-width: 1024px) {
    .hero-line2 {
      font-size: min(5.6vw, 5.75rem);
    }
  }
</style>
