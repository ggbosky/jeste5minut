---
import Book from './Book.astro';
import { pricing } from '../../site.config';
import { getContent } from '../content';
import { czk, currentPrice } from '../lib/format';

const h = getContent().hero;
const now = currentPrice(pricing.basic);
---

<section id="top" class="pt-14 pb-20 text-center sm:pt-20 sm:pb-28">
  <div class="container-page">
    <h1 class="text-[3rem] sm:text-7xl">{h.title}</h1>
    <p class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{h.subtitle}</p>
    <p class="mx-auto mt-5 max-w-[32rem] text-lg leading-relaxed text-muted">{h.text}</p>

    <div class="mt-8 flex flex-col items-center gap-4">
      <div class="flex items-center gap-4">
        <span class="text-2xl font-semibold tracking-tight">{czk(now)}</span>
        {
          pricing.basic.launch && (
            <span class="text-muted">
              {h.regularLabel} <s>{czk(pricing.basic.regular)}</s>
            </span>
          )
        }
        <a href="#cena" class="btn" data-track="cta_hero">{h.buy}</a>
      </div>
      <a href="#sos-karta" class="link text-[0.9375rem] text-muted">{h.free}</a>
    </div>

    <Book class="mt-16 [--w:14rem] sm:mt-20 sm:[--w:18rem]" />

    <dl class="mx-auto mt-16 grid max-w-[36rem] grid-cols-3 gap-6 border-t border-line pt-8 sm:mt-20">
      {
        h.facts.map((f) => (
          <div>
            <dt class="sr-only">{f.label}</dt>
            <dd class="text-3xl font-semibold tracking-tight sm:text-4xl">{f.value}</dd>
            <dd class="mt-1 text-sm text-muted">{f.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
