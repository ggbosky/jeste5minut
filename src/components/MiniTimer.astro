---
import { pricing } from '../../site.config';
import { getContent } from '../content';
import { czk, currentPrice } from '../lib/format';

const m = getContent().miniTimer;
const price = czk(currentPrice(pricing.basic));
---

<!-- Plovoucí mini časovač. Mobil: spodní lišta s CTA. Desktop: kulatý čip vlevo dole. -->
<div class="mini-timer" data-mini-timer aria-hidden="true">
  <a href="#cena" class="mini-inner" tabindex="-1">
    <span class="mini-clock">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="13" r="8" stroke="currentColor" stroke-width="2.6"></circle>
        <path d="M12 9v4l2.5 2M9 2h6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
      </svg>
      <span class="mini-label">{m.label}</span>
      <span class="mini-digits" data-mini-digits data-done={m.done}>5:00</span>
    </span>
    <span class="mini-cta">{m.cta} · {price}</span>
  </a>
</div>

<style>
  .mini-timer {
    position: fixed;
    z-index: 40;
    left: 0.75rem;
    right: 0.75rem;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    translate: 0 calc(100% + 2rem);
    transition: translate 0.45s var(--ease-out-expo);
    pointer-events: none;
  }
  .mini-timer.is-visible {
    translate: 0 0;
    pointer-events: auto;
  }
  :global(.has-consent-bar) .mini-timer.is-visible {
    pointer-events: none;
    translate: 0 calc(100% + 2rem);
  }
  .mini-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.45rem 0.45rem 1rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 3px solid var(--color-ink);
    border-radius: 999px;
    box-shadow: 4px 4px 0 var(--color-coral);
  }
  .mini-clock {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .mini-label {
    opacity: 0.75;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .mini-digits {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    min-width: 2.6em;
  }
  .mini-cta {
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--color-coral);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    white-space: nowrap;
    border: 2.5px solid var(--color-paper);
  }
  @media (max-width: 359px) {
    .mini-label {
      display: none;
    }
  }
  @media (min-width: 768px) {
    .mini-timer {
      left: 1.25rem;
      right: auto;
      bottom: 1.25rem;
    }
    .mini-cta {
      display: none;
    }
    .mini-inner {
      padding: 0.6rem 1.1rem;
    }
    .mini-inner:hover {
      box-shadow: 6px 6px 0 var(--color-coral);
    }
  }
</style>

<script>
  import { fmt, onTick } from '../lib/timer';

  const box = document.querySelector<HTMLElement>('[data-mini-timer]');
  if (box) {
    const digits = box.querySelector<HTMLElement>('[data-mini-digits]')!;
    const link = box.querySelector<HTMLAnchorElement>('a')!;
    onTick((ms) => {
      digits.textContent = ms > 0 ? fmt(ms) : digits.dataset.done!;
    });

    // Ukázat po opuštění hera, schovat u ceny a u finálního CTA (tam je CTA vidět tak jako tak)
    const hero = document.getElementById('top');
    const hideAt = ['cena', 'start'].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const state = { pastHero: false, hiddenBy: new Set<Element>() };
    const update = () => {
      const visible = state.pastHero && state.hiddenBy.size === 0;
      box.classList.toggle('is-visible', visible);
      link.tabIndex = visible ? 0 : -1;
      box.toggleAttribute('aria-hidden', !visible);
    };
    if (hero) {
      new IntersectionObserver(([e]) => {
        state.pastHero = !e.isIntersecting;
        update();
      }).observe(hero);
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? state.hiddenBy.add(e.target) : state.hiddenBy.delete(e.target)));
      update();
    });
    hideAt.forEach((el) => io.observe(el));
  }
</script>
