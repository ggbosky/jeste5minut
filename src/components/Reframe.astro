---
import { getContent } from '../content';
import { rich } from '../lib/rich';

const r = getContent().reframe;
---

<section class="relative bg-ink py-20 text-paper sm:py-28 lg:py-36" aria-labelledby="reframe-title">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-10">
    <p class="kicker mb-6" data-reveal>{r.kicker}</p>
    <h2 id="reframe-title">
      <span class="display-xl block" data-reveal style="--i:1" set:html={rich(r.title[0])} />
      <span class="display-md mt-4 block max-w-[18ch] sm:mt-6" data-reveal style="--i:2" set:html={rich(r.title[1])} />
    </h2>

    <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-12">
      <p class="text-lg leading-relaxed text-paper/85 sm:text-xl lg:col-span-5" data-reveal set:html={rich(r.body)} />
      <ul class="grid gap-8 sm:grid-cols-3 lg:col-span-7 lg:gap-8">
        {
          r.points.map((p, i) => (
            <li class="border-t border-paper/25 pt-5" data-reveal style={`--i:${i + 1}`}>
              <h3 class="text-[1.75rem] leading-none" set:html={rich(p.title)} />
              <p class="mt-3 leading-relaxed text-paper/80" set:html={rich(p.text)} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
