---
/** Text, který se při scrollu postupně „rozsvěcí“ slovo po slově. Bez JS je celý vidět normálně. */
import { getContent } from '../content';
import { nbsp } from '../lib/rich';

const words = nbsp(getContent().statement).split(' ');
---

<section class="py-24 sm:py-36" data-statement>
  <p class="statement container-page max-w-[60rem]">
    {words.map((w) => <span class="sw">{w} </span>)}
  </p>
</section>

<style>
  .statement {
    font-size: clamp(1.9rem, 5.2vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
    text-wrap: balance;
  }
  :global(html.js) .statement.is-live .sw {
    color: color-mix(in srgb, var(--color-ink) 50%, white);
    transition: color 0.35s ease;
  }
  :global(html.js) .statement.is-live .sw.is-lit {
    color: var(--color-ink);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-statement]');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !calm) {
    const p = root.querySelector<HTMLElement>('.statement')!;
    const words = [...p.querySelectorAll<HTMLElement>('.sw')];
    p.classList.add('is-live');
    let lit = -1;
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = p.getBoundingClientRect();
      // začne se rozsvěcet, když je text v dolních 85 % obrazovky, hotovo ve 35 %
      const start = innerHeight * 0.85;
      const end = innerHeight * 0.35;
      const prog = Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height * 0.6)));
      const n = Math.round(prog * words.length);
      if (n !== lit) {
        words.forEach((w, i) => w.classList.toggle('is-lit', i < n));
        lit = n;
      }
    };
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }
</script>
