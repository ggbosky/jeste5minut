---
import { getContent } from '../content';
import { rich } from '../lib/rich';

const f = getContent().faq;
---

<section id="faq" class="bg-soft py-20 sm:py-28" aria-labelledby="faq-title">
  <div class="container-page grid gap-10 md:grid-cols-12">
    <h2 id="faq-title" class="section-title md:col-span-4" data-reveal>{f.title}</h2>
    <div class="md:col-span-8">
      {
        f.items.map((item) => (
          <details class="faq border-t border-line" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-medium">
              <span set:html={rich(item.q)} />
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <p class="max-w-[40rem] pb-6 leading-relaxed text-muted" set:html={rich(item.a)} />
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    transition: rotate 0.3s var(--ease-out-expo);
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 0;
    width: 12px;
    height: 1.5px;
    translate: 0 -50%;
    background: currentColor;
  }
  .faq-icon::after {
    rotate: 90deg;
  }
  .faq[open] .faq-icon {
    rotate: 45deg;
  }
</style>
