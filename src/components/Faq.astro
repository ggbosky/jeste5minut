---
import { getContent } from '../content';
import { rich } from '../lib/rich';

const f = getContent().faq;
---

<section id="faq" class="bg-ink py-20 text-white sm:py-28" aria-labelledby="faq-title">
  <div class="container-page">
    <h2 id="faq-title" class="section-title text-center" data-reveal>{f.title}</h2>
    <div class="mx-auto mt-12 grid max-w-[48rem] gap-3">
      {
        f.items.map((item) => (
          <details class="faq" name="faq" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-lg font-medium">
              <span set:html={rich(item.q)} />
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <p class="max-w-[40rem] px-6 pb-6 leading-relaxed text-white/70" set:html={rich(item.a)} />
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    border-radius: 18px;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    transition: background-color 0.25s;
  }
  .faq:hover,
  .faq[open] {
    background: rgb(255 255 255 / 0.09);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    transition:
      rotate 0.3s var(--ease-out-expo),
      background-color 0.25s;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 12px;
    height: 1.5px;
    translate: -50% -50%;
    background: currentColor;
  }
  .faq-icon::after {
    rotate: 90deg;
  }
  .faq[open] .faq-icon {
    rotate: 45deg;
    background: var(--color-coral);
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq[open] p {
      animation: faq-in 0.35s var(--ease-out-expo);
    }
  }
  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
