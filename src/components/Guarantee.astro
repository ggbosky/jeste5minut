---
import { getContent } from '../content';
import { rich } from '../lib/rich';

// TODO: znění záruky doplní majitel (src/content/cs.ts → guarantee)
const g = getContent().guarantee;
const ring = `${g.kicker} · ${g.kicker} · `.toUpperCase();
---

<section class="relative bg-paper-deep pb-20 sm:pb-28" aria-labelledby="guarantee-title">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-10">
    <div class="card flex flex-col items-start gap-6 p-6 sm:flex-row sm:items-center sm:gap-10 sm:p-10" data-reveal>
      <div class="seal relative size-32 shrink-0 sm:size-36" aria-hidden="true">
        <svg viewBox="0 0 200 200" class="seal-text absolute inset-0 size-full">
          <defs><path id="seal-path" d="M100 100m-78 0a78 78 0 1 1 156 0a78 78 0 1 1-156 0"></path></defs>
          <circle cx="100" cy="100" r="96" fill="var(--color-marker)" stroke="var(--color-ink)" stroke-width="6"></circle>
          <text font-family="Space Mono, monospace" font-weight="700" font-size="17" letter-spacing="3" fill="var(--color-ink)">
            <textPath href="#seal-path">{ring}</textPath>
          </text>
        </svg>
        <svg viewBox="0 0 200 200" class="absolute inset-0 size-full">
          <circle cx="100" cy="100" r="52" fill="var(--color-mint)" stroke="var(--color-ink)" stroke-width="6"></circle>
          <path d="m76 102 17 17 33-36" fill="none" stroke="var(--color-ink)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <div>
        <p class="kicker mb-3">{g.kicker}</p>
        <h2 id="guarantee-title" class="text-[2rem] leading-none sm:text-5xl" set:html={rich(g.title)} />
        <p class="mt-4 max-w-[40rem] text-lg leading-relaxed" set:html={rich(g.text)} />
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .seal-text {
      animation: spin 24s linear infinite;
    }
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
</style>
