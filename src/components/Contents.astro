---
import { getContent } from '../content';
import { rich } from '../lib/rich';

const c = getContent().contents;
---

<section id="obsah" class="bg-ink py-20 text-white sm:py-28" aria-labelledby="contents-title">
  <div class="container-page">
    <div class="mx-auto max-w-[40rem] text-center" data-reveal>
      <h2 id="contents-title" class="section-title">{c.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-white/70" set:html={rich(c.intro)} />
    </div>

    <ol class="mx-auto mt-14 grid max-w-[56rem] gap-x-12 md:grid-cols-2">
      {
        c.chapters.map((ch, n) => (
          <li class="chapter" data-reveal>
            <span class="chapter-n tabular-nums" aria-hidden="true">
              {String(n + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-lg font-semibold tracking-tight">{ch.title}</h3>
              <p class="mt-1 leading-relaxed text-white/65" set:html={rich(ch.text)} />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .chapter {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 0 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .chapter-n {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-coral);
  }
</style>
