---
import { getContent } from '../content';
import { rich } from '../lib/rich';

const l = getContent().learn;
---

<section class="bg-soft py-20 sm:py-28" aria-labelledby="learn-title">
  <div class="container-page grid gap-10 md:grid-cols-12">
    <h2 id="learn-title" class="section-title md:col-span-4" data-reveal>{l.title}</h2>
    <ul class="grid gap-x-10 sm:grid-cols-2 md:col-span-8">
      {
        l.items.map((item) => (
          <li class="flex gap-3 border-t border-line py-4 text-lg leading-snug" data-reveal>
            <svg class="mt-1 shrink-0 text-coral" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span set:html={rich(item)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
