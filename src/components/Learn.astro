---
import { getContent } from '../content';
import { rich } from '../lib/rich';

const l = getContent().learn;
---

<section class="bg-soft py-20 sm:py-28" aria-labelledby="learn-title">
  <div class="container-page">
    <div class="max-w-[40rem]" data-reveal>
      <h2 id="learn-title" class="section-title">{l.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted" set:html={rich(l.intro)} />
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        l.items.map((item) => (
          <li class="change" data-reveal>
            <p class="before">
              <span class="sr-only">Dřív: </span>
              <s>{item.before}</s>
            </p>
            <p class="after">
              <span class="sr-only">Teď: </span>
              <span class="after-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span set:html={rich(item.after)} />
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .change {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.6rem;
    border-radius: 22px;
    background: var(--color-paper);
    box-shadow:
      0 1px 2px rgb(20 33 61 / 0.04),
      0 12px 30px -18px rgb(20 33 61 / 0.25);
    transition:
      translate 0.35s var(--ease-out-expo),
      box-shadow 0.35s;
  }
  .change:hover {
    translate: 0 -4px;
    box-shadow:
      0 1px 2px rgb(20 33 61 / 0.04),
      0 22px 40px -18px rgb(20 33 61 / 0.32);
  }
  .before {
    color: var(--color-muted);
    font-size: 1rem;
  }
  .before s {
    position: relative;
    text-decoration: none;
  }
  /* oranžové škrtnutí se dokreslí, když karta najede */
  .before s::after {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    top: 55%;
    height: 2px;
    border-radius: 2px;
    background: var(--color-coral);
    transform-origin: left;
  }
  .after {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .after-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: 0.05rem;
    border-radius: 999px;
    background: var(--color-coral);
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .change[data-reveal] .before s::after {
      transform: scaleX(0);
      transition: transform 0.6s var(--ease-out-expo) calc(var(--i, 0) * 70ms + 0.35s);
    }
    :global(.js) .change[data-reveal].is-in .before s::after {
      transform: scaleX(1);
    }
  }
</style>
