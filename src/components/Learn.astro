---
import { getContent } from '../content';
import { rich } from '../lib/rich';

const l = getContent().learn;
---

<section class="bg-soft py-20 sm:py-28" aria-labelledby="learn-title">
  <div class="container-page">
    <div class="mx-auto max-w-[40rem] text-center" data-reveal>
      <h2 id="learn-title" class="section-title">{l.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted" set:html={rich(l.intro)} />
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        l.items.map((item) => (
          <li class="change" data-reveal>
            <span class="change-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <p class="after" set:html={rich(item.after)} />
            <p class="before">
              <span class="before-label">{l.beforeLabel}</span> {item.before}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .change {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.75rem;
    border-radius: 22px;
    background: var(--color-paper);
    box-shadow:
      0 1px 2px rgb(20 33 61 / 0.04),
      0 12px 30px -18px rgb(20 33 61 / 0.25);
    transition:
      translate 0.35s var(--ease-out-expo),
      box-shadow 0.35s;
  }
  .change:hover {
    translate: 0 -4px;
    box-shadow:
      0 1px 2px rgb(20 33 61 / 0.04),
      0 22px 40px -18px rgb(20 33 61 / 0.32);
  }
  .change-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--color-coral);
    color: var(--color-ink);
  }
  /* řešení je hlavní sdělení */
  .after {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  /* problém jen jako malá poznámka, čitelná, bez škrtnutí */
  .before {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .before-label {
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
