---
/**
 * Typický večer před zkouškou: časy a věty pod sebou, každý řádek najede při scrollu.
 * Nic se nepřipíná – sekce se scrolluje normálně s celou stránkou.
 */
import { getContent } from '../content';

const s = getContent().story;
---

<section class="bg-ink py-24 text-white sm:py-32" aria-label={s.label}>
  <ol class="container-page grid max-w-[56rem] gap-10 sm:gap-14">
    {
      s.steps.map((step, i) => (
        <li class:list={['story-row', i === s.steps.length - 1 && 'is-last']} data-reveal>
          <span class="story-time tabular-nums">{step.time}</span>
          <span class="story-text">{step.text}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .story-row {
    display: grid;
    gap: 0.25rem;
    align-items: baseline;
  }
  @media (min-width: 640px) {
    .story-row {
      grid-template-columns: 15rem 1fr;
      gap: 2.5rem;
    }
  }
  .story-time {
    font-size: clamp(3rem, 12vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    color: rgb(255 255 255 / 0.35);
  }
  .story-text {
    font-size: clamp(1.5rem, 4.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .story-row.is-last .story-time,
  .story-row.is-last .story-text {
    color: var(--color-coral);
  }
</style>
