---
/**
 * Self-hosted fonty (Fontsource), jen woff2, jen latin + latin-ext
 * (čeština i slovenčina: ěščřžýáíéůú ľĺŕôä). Prohlížeč stáhne latin-ext až když ho text potřebuje.
 *
 * „Archivo“ = variabilní, normální šířka na text (osa wght).
 * „Archivo Display“ = statický úzký řez 800 jen se znaky CZ/SK na nadpisy
 *   (~10 kB místo ~90 kB, vyrábí ho scripts/make-fonts.py).
 */
import arText from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import arTextX from '@fontsource-variable/archivo/files/archivo-latin-ext-wght-normal.woff2?url';
import arDisplay from '../assets/fonts/archivo-display-800-latin.woff2?url';
import arDisplayX from '../assets/fonts/archivo-display-800-latin-ext.woff2?url';
import jb500 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url';
import jb500x from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-ext-500-normal.woff2?url';

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

const faces: [family: string, weight: string, stretch: string, latin: string, ext: string][] = [
  ['Archivo', '100 900', '100%', arText, arTextX],
  ['Archivo Display', '800', '72%', arDisplay, arDisplayX],
  ['JetBrains Mono', '500', '100%', jb500, jb500x],
];

const css = faces
  .flatMap(([family, weight, stretch, latin, ext]) =>
    [
      [latin, LATIN],
      [ext, LATIN_EXT],
    ].map(
      ([src, range]) =>
        `@font-face{font-family:'${family}';font-style:normal;font-weight:${weight};font-stretch:${stretch};font-display:swap;src:url(${src}) format('woff2');unicode-range:${range}}`,
    ),
  )
  .join('');
---

<link rel="preload" href={arDisplay} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={arText} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css} />
