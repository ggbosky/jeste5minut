---
/**
 * Self-hosted fonty (Fontsource), jen woff2, jen latin + latin-ext
 * (čeština i slovenčina: ěščřžýáíéůú ľĺŕôä). Prohlížeč stáhne latin-ext až když ho text potřebuje.
 */
import sg700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import sg700x from '@fontsource/space-grotesk/files/space-grotesk-latin-ext-700-normal.woff2?url';
import in400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import in400x from '@fontsource/inter/files/inter-latin-ext-400-normal.woff2?url';
import in600 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import in600x from '@fontsource/inter/files/inter-latin-ext-600-normal.woff2?url';
import sm400 from '@fontsource/space-mono/files/space-mono-latin-400-normal.woff2?url';
import sm400x from '@fontsource/space-mono/files/space-mono-latin-ext-400-normal.woff2?url';
import sm700 from '@fontsource/space-mono/files/space-mono-latin-700-normal.woff2?url';
import sm700x from '@fontsource/space-mono/files/space-mono-latin-ext-700-normal.woff2?url';

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

const faces: [family: string, weight: number, latin: string, ext: string][] = [
  ['Space Grotesk', 700, sg700, sg700x],
  ['Inter', 400, in400, in400x],
  ['Inter', 600, in600, in600x],
  ['Space Mono', 400, sm400, sm400x],
  ['Space Mono', 700, sm700, sm700x],
];

const css = faces
  .flatMap(([family, weight, latin, ext]) =>
    [
      [latin, LATIN],
      [ext, LATIN_EXT],
    ].map(
      ([src, range]) =>
        `@font-face{font-family:'${family}';font-style:normal;font-weight:${weight};font-display:swap;src:url(${src}) format('woff2');unicode-range:${range}}`,
    ),
  )
  .join('');
---

<link rel="preload" href={sg700} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={sg700x} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={in400} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css} />
