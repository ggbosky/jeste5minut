---
import { pricing } from '../../site.config';
import { getContent } from '../content';
import { czk, eur } from '../lib/format';
import { rich } from '../lib/rich';

const p = getContent().pricing;
const plans = [
  { key: 'basic' as const, cfg: pricing.basic, featured: false },
  { key: 'bundle' as const, cfg: pricing.bundle, featured: true },
];
---

<section id="cena" class="bg-paper py-20 sm:py-28" aria-labelledby="price-title">
  <div class="container-page">
    <h2 id="price-title" class="section-title text-center" data-reveal>{p.title}</h2>

    <div class="mx-auto mt-12 grid max-w-[52rem] gap-5 md:grid-cols-2">
      {
        plans.map(({ key, cfg, featured }) => {
          const plan = p.plans[key];
          const now = cfg.launch ?? cfg.regular;
          return (
            <div class:list={['plan-wrap', featured && 'is-featured']} data-reveal>
            <article
              class:list={['plan flex h-full flex-col rounded-3xl bg-paper p-7 sm:p-9', !featured && 'border border-line']}
              aria-labelledby={`plan-${key}`}
            >
              {featured && <p class="mb-2 text-sm font-semibold text-coral-text">{p.popular}</p>}
              <h3 id={`plan-${key}`} class="text-xl font-semibold tracking-tight">
                {plan.name}
              </h3>
              <p class="mt-4 flex items-baseline gap-3">
                <span class="text-4xl font-bold tracking-tight">{czk(now)}</span>
                {cfg.launch && (
                  <span class="text-muted">
                    {p.regularLabel} <s>{czk(cfg.regular)}</s>
                  </span>
                )}
              </p>
              <p class="mt-1 text-sm text-muted">
                {p.eurLabel}: {eur(cfg.eur)}
              </p>

              <ul class="mt-7 mb-8 grid gap-2.5">
                {plan.features.map((f) => (
                  <li class="flex gap-3 leading-snug">
                    <svg class="mt-0.5 shrink-0 text-coral" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span set:html={rich(f)} />
                  </li>
                ))}
              </ul>

              <a href={cfg.checkoutUrl} class:list={['btn btn-lg btn-arrow mt-auto w-full', featured ? 'btn-glow' : 'btn-dark']} data-track={`checkout_${key}`} rel="nofollow">
                {plan.cta}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </article>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* Světelný okraj, který obíhá kolem oblíbené varianty */
  @property --glow-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  .plan-wrap {
    position: relative;
    isolation: isolate;
    border-radius: 26px;
  }
  .plan-wrap.is-featured {
    padding: 2px;
  }
  /* tenký okraj: tlumená oranžová dokola + jasná linka, která obíhá */
  .plan-wrap.is-featured::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: conic-gradient(
      from var(--glow-angle),
      rgb(251 103 32 / 0.35) 0deg,
      rgb(251 103 32 / 0.35) 250deg,
      var(--color-coral) 300deg,
      #ffd2b3 330deg,
      var(--color-coral) 345deg,
      rgb(251 103 32 / 0.35) 360deg
    );
  }
  /* rovnoměrná záře kolem celé karty */
  .plan-wrap.is-featured::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    border-radius: inherit;
    box-shadow:
      0 0 0 1px rgb(251 103 32 / 0.25),
      0 0 24px rgb(251 103 32 / 0.28),
      0 18px 60px -10px rgb(251 103 32 / 0.35);
  }
  @media (prefers-reduced-motion: no-preference) {
    .plan-wrap.is-featured::before {
      animation: glow-spin 4s linear infinite;
    }
    .plan-wrap.is-featured::after {
      animation: glow-breathe 3s ease-in-out infinite;
    }
  }
  @keyframes glow-spin {
    to {
      --glow-angle: 360deg;
    }
  }
  @keyframes glow-breathe {
    50% {
      opacity: 0.55;
    }
  }
  .plan-wrap.is-featured .plan {
    border-radius: 24px;
  }
</style>

<script>
  import { track } from '../lib/analytics';
  document.querySelectorAll<HTMLAnchorElement>('[data-track^=checkout_]').forEach((a) =>
    a.addEventListener('click', () => track('checkout_click', { plan: a.dataset.track!.replace('checkout_', '') })),
  );
</script>
