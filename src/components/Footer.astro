---
import { analytics, contact, socials } from '../../site.config';
import Logo from './Logo.astro';
import { getContent } from '../content';

const f = getContent().footer;
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-10 text-sm text-muted">
  <!-- TODO: kontaktní údaje doplň v site.config.ts → contact -->
  <div class="container-page flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
    <div class="grid gap-1">
      <p class="text-ink"><Logo /></p>
      <p>{contact.company} · IČO {contact.ico}</p>
      <p><a href={`mailto:${contact.email}`} class="link">{contact.email}</a></p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        f.legal.map((l) => (
          <li>
            <a href={l.href} class="hover:text-ink">
              {l.label}
            </a>
          </li>
        ))
      }
      {
        analytics.provider && (
          <li>
            <button type="button" class="cursor-pointer hover:text-ink" data-open-consent>
              {f.cookieSettings}
            </button>
          </li>
        )
      }
      <li><a href={socials.tiktok} class="hover:text-ink" rel="noopener" target="_blank">TikTok</a></li>
      <li><a href={socials.instagram} class="hover:text-ink" rel="noopener" target="_blank">Instagram</a></li>
    </ul>
  </div>
  <p class="container-page mt-6">© {year} {contact.company}</p>
</footer>
