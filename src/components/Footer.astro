---
import Logo from './Logo.astro';
import { analytics, contact, socials } from '../../site.config';
import { getContent } from '../content';
import { rich } from '../lib/rich';

const f = getContent().footer;
const year = new Date().getFullYear();
---

<footer class="grain grain-dark relative bg-ink pt-16 pb-28 text-paper sm:pt-20 md:pb-12">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-10">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12">
      <div class="sm:col-span-2 lg:col-span-5">
        <a href="#top" class="text-3xl sm:text-4xl" aria-label={f.toTop}><Logo dark /></a>
        <p class="mt-5 max-w-[24rem] leading-relaxed text-paper/80" set:html={rich(f.tagline)} />
      </div>

      <nav class="lg:col-span-3" aria-labelledby="f-legal">
        <h2 id="f-legal" class="font-mono text-sm font-normal tracking-wide uppercase opacity-70">{f.legalTitle}</h2>
        <ul class="mt-4 grid gap-2.5">
          {
            f.legal.map((l) => (
              <li>
                <a href={l.href} class="link decoration-paper/40">
                  {l.label}
                </a>
              </li>
            ))
          }
          {
            analytics.provider && (
              <li>
                <button type="button" class="link cursor-pointer decoration-paper/40" data-open-consent>
                  {f.cookieSettings}
                </button>
              </li>
            )
          }
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <h2 class="font-mono text-sm font-normal tracking-wide uppercase opacity-70">{f.contactTitle}</h2>
        <!-- TODO: kontaktní údaje doplň v site.config.ts → contact -->
        <ul class="mt-4 grid gap-2.5">
          <li><a href={`mailto:${contact.email}`} class="link decoration-paper/40">{contact.email}</a></li>
          <li class="text-sm text-paper/70">{contact.company}</li>
          <li class="text-sm text-paper/70">IČO {contact.ico}</li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h2 class="font-mono text-sm font-normal tracking-wide uppercase opacity-70">{f.socialTitle}</h2>
        <ul class="mt-4 flex gap-3">
          <li>
            <a href={socials.tiktok} class="social" aria-label="TikTok" rel="noopener" target="_blank">
              <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.6 2.6 0 0 1-2.6-2.6 2.6 2.6 0 0 1 3.37-2.48V9.66A5.72 5.72 0 0 0 4.08 15.3a5.7 5.7 0 0 0 5.78 5.7 5.7 5.7 0 0 0 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.25-1.48Z" />
              </svg>
            </a>
          </li>
          <li>
            <a href={socials.instagram} class="social" aria-label="Instagram" rel="noopener" target="_blank">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2.2" />
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2.2" />
                <circle cx="17.3" cy="6.7" r="1.3" fill="currentColor" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t-2 border-paper/20 pt-6 font-mono text-xs text-paper/70 sm:flex-row sm:justify-between">
      <p>© {year} {contact.company}. {f.rights}</p>
      <p aria-hidden="true" set:html={rich(f.signoff)} />
    </div>
  </div>
</footer>

<style>
  .social {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 2.5px solid var(--color-paper);
    border-radius: 999px;
    transition:
      background-color 0.2s,
      color 0.2s,
      translate 0.2s;
  }
  .social:hover {
    background: var(--color-paper);
    color: var(--color-ink);
    translate: 0 -2px;
  }
</style>
