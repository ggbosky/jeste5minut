---
import { site, shop } from '../../site.config';
import Logo from './Logo.astro';
import { getContent } from '../content';

const f = getContent().footer;
const year = new Date().getFullYear();
---

<!-- Právní stránky a kontakt jsou napsané v Shopify (Nastavení → Zásady) -->
<footer class="border-t border-line py-10 text-sm text-muted">
  <div class="container-page flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <p class="text-ink"><Logo /></p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        f.policies.map((l) => (
          <li>
            <a href={`${shop.url}/policies/${l.handle}`} class="hover:text-ink">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="container-page mt-6">© {year} {site.name}</p>
</footer>
