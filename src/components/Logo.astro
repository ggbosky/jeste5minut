---
interface Props {
  class?: string;
  dark?: boolean;
}
const { class: cls = '' } = Astro.props;
---

<span class:list={['logo inline-flex items-baseline gap-[0.22em] font-display leading-none', cls]}>
  <span>ještě</span><span class="text-coral">5</span><span>minut</span>
</span>

<style>
  .logo {
    font-weight: 800;
    font-stretch: 72%;
    letter-spacing: -0.005em;
  }
</style>
