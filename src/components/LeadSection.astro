---
import LeadForm from './LeadForm.astro';
import { getContent } from '../content';
import { rich } from '../lib/rich';

const l = getContent().lead;
---

<section id="sos-karta" class="py-20 sm:py-28" aria-labelledby="sos-title">
  <div class="container-page">
    <div class="mx-auto max-w-[36rem] text-center" data-reveal>
      <h2 id="sos-title" class="section-title">{l.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted" set:html={rich(l.text)} />
      <div class="mt-8 text-left">
        <LeadForm id="lead-main" source="sos-karta" />
      </div>
    </div>
  </div>
</section>
