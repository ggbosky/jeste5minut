---
import { analytics } from '../../site.config';
import { getContent } from '../content';

const t = getContent();
const enabled = analytics.provider !== null;
---

{
  enabled && (
    <div
      id="cookie-consent"
      role="dialog"
      aria-live="polite"
      aria-label={t.cookies.label}
      hidden
      class="fixed inset-x-3 bottom-3 z-[90] mx-auto max-w-xl sm:inset-x-auto sm:right-5 sm:bottom-5 sm:w-[30rem]"
    >
      <div class="card flex flex-col gap-4 p-5">
        <p class="text-[0.9375rem] leading-snug">{t.cookies.text}</p>
        <div class="flex shrink-0 gap-3">
          <button type="button" class="btn btn-sm btn-ink" data-consent="denied">
            {t.cookies.decline}
          </button>
          <button type="button" class="btn btn-sm" data-consent="granted">
            {t.cookies.accept}
          </button>
        </div>
      </div>
    </div>
  )
}

<script>
  import { analyticsEnabled, getConsent, loadAnalytics, setConsent, type Consent } from '../lib/analytics';

  const box = document.getElementById('cookie-consent');
  if (box && analyticsEnabled()) {
    const show = () => {
      box.hidden = false;
      // Mobilní CTA lišta se posune nad lištu cookies
      document.documentElement.classList.add('has-consent-bar');
    };
    const hide = () => {
      box.hidden = true;
      document.documentElement.classList.remove('has-consent-bar');
    };

    const current = getConsent();
    if (current === 'granted') loadAnalytics();
    // Lištu ukážeme až po chvíli, ať nepřekáží prvnímu dojmu ani LCP
    else if (current === null) setTimeout(show, 2500);

    box.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
      b.addEventListener('click', () => {
        setConsent(b.dataset.consent as Consent);
        hide();
      }),
    );
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-open-consent]')) {
        e.preventDefault();
        show();
      }
    });
  }
</script>
