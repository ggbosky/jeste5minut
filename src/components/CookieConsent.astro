---
import { analytics } from '../../site.config';
import { getContent } from '../content';

const t = getContent();
const enabled = analytics.provider !== null;
---

{
  enabled && (
    <div
      id="cookie-consent"
      role="dialog"
      aria-live="polite"
      aria-label={t.cookies.label}
      hidden
      class="fixed inset-x-3 bottom-3 z-[90] mx-auto max-w-xl sm:inset-x-auto sm:right-5 sm:bottom-5 sm:w-[38rem]"
    >
      <div class="flex flex-col gap-3 rounded-2xl border border-line bg-paper p-4 shadow-[0_10px_40px_-12px_rgb(20_33_61/0.25)] sm:flex-row sm:items-center sm:gap-4">
        <p class="text-sm leading-snug text-muted">{t.cookies.text}</p>
        <div class="flex shrink-0 gap-3">
          <button type="button" class="btn btn-sm btn-dark" data-consent="denied">
            {t.cookies.decline}
          </button>
          <button type="button" class="btn btn-sm !bg-soft hover:!bg-line" data-consent="granted">
            {t.cookies.accept}
          </button>
        </div>
      </div>
    </div>
  )
}

<script>
  import { analyticsEnabled, getConsent, loadAnalytics, setConsent, type Consent } from '../lib/analytics';

  const box = document.getElementById('cookie-consent');
  if (box && analyticsEnabled()) {
    const show = () => (box.hidden = false);
    const hide = () => (box.hidden = true);

    const current = getConsent();
    if (current === 'granted') loadAnalytics();
    // Lištu ukážeme až po prvním scrollu, ať nezakrývá hero a hlavní tlačítko
    else if (current === null) addEventListener('scroll', () => setTimeout(show, 600), { once: true, passive: true });

    box.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
      b.addEventListener('click', () => {
        setConsent(b.dataset.consent as Consent);
        hide();
      }),
    );
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-open-consent]')) {
        e.preventDefault();
        show();
      }
    });
  }
</script>
