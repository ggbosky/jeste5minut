---
import { getContent } from '../content';
import { rich } from '../lib/rich';

interface Props {
  /** unikátní id formuláře na stránce */
  id: string;
  /** odkud lead přišel – pošle se do e-mailové služby */
  source: string;
}

const { id, source } = Astro.props;
const l = getContent().lead;
---

<div class="lead-form" data-lead-form>
  <form id={id} novalidate data-source={source} class="grid gap-4">
    <div class="flex flex-col gap-3 sm:flex-row">
      <label class="sr-only" for={`${id}-email`}>{l.emailLabel}</label>
      <input
        id={`${id}-email`}
        type="email"
        name="email"
        required
        autocomplete="email"
        inputmode="email"
        placeholder={l.emailPlaceholder}
        aria-describedby={`${id}-email-err`}
        class="h-12 w-full min-w-0 rounded-full sm:flex-1 border border-line bg-paper px-5 text-base outline-none focus:border-ink"
      />
      <button type="submit" class="btn btn-dark" data-label={l.submit} data-sending={l.sending}>{l.submit}</button>
    </div>
    <p id={`${id}-email-err`} class="hidden text-sm text-coral-text" data-err-for="email">{l.invalidEmail}</p>

    <label class="flex cursor-pointer items-start gap-3 text-sm leading-snug text-muted">
      <input type="checkbox" name="consent" class="mt-0.5 size-4 shrink-0 accent-ink" aria-describedby={`${id}-consent-err`} />
      <span set:html={rich(l.consent)} />
    </label>
    <p id={`${id}-consent-err`} class="hidden text-sm text-coral-text" data-err-for="consent">{l.consentRequired}</p>
    <p class="form-error hidden text-sm text-coral-text" role="alert">{l.error}</p>
  </form>

  <div class="form-success hidden" tabindex="-1">
    <p class="text-lg font-semibold">{l.successTitle}</p>
    <p class="mt-1 text-muted">{l.successText}</p>
  </div>
</div>

<script>
  import { isValidEmail, subscribe } from '../lib/subscribe';
  import { track } from '../lib/analytics';

  document.querySelectorAll<HTMLElement>('[data-lead-form]').forEach((wrap) => {
    const form = wrap.querySelector('form')!;
    const success = wrap.querySelector<HTMLElement>('.form-success')!;
    const errorBox = wrap.querySelector<HTMLElement>('.form-error')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const consent = form.elements.namedItem('consent') as HTMLInputElement;

    const setErr = (name: 'email' | 'consent', on: boolean) => {
      form.querySelector(`[data-err-for=${name}]`)!.classList.toggle('hidden', !on);
      (name === 'email' ? email : consent).setAttribute('aria-invalid', String(on));
    };
    email.addEventListener('input', () => email.getAttribute('aria-invalid') === 'true' && isValidEmail(email.value) && setErr('email', false));
    consent.addEventListener('change', () => consent.checked && setErr('consent', false));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      const okEmail = isValidEmail(email.value);
      setErr('email', !okEmail);
      setErr('consent', !consent.checked);
      if (!okEmail) return email.focus();
      if (!consent.checked) return consent.focus();

      btn.disabled = true;
      btn.textContent = btn.dataset.sending!;
      try {
        await subscribe({ email: email.value, consent: consent.checked, source: form.dataset.source || 'web' });
        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.focus();
        track('lead', { source: form.dataset.source || 'web' });
      } catch (err) {
        console.error(err);
        errorBox.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = btn.dataset.label!;
      }
    });
  });
</script>
