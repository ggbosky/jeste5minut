---
import Book from './Book.astro';
import { getContent } from '../content';
import { rich } from '../lib/rich';

const i = getContent().inside;

// Mini ilustrace bonusů (dekorativní SVG)
const art: Record<string, string> = {
  planner: `<rect x="4" y="6" width="112" height="72" rx="6" fill="var(--color-paper)" stroke="currentColor" stroke-width="1.5"/>
    <path d="M4 22h112" stroke="currentColor" stroke-width="1.5"/>
    ${[0, 1, 2, 3, 4, 5, 6].map((d) => `<path d="M${4 + d * 16} 22v56" stroke="currentColor" stroke-width="${d ? 1.5 : 0}"/>`).join('')}
    <rect x="23" y="30" width="10" height="6" rx="2" fill="var(--color-coral)"/><rect x="55" y="44" width="10" height="6" rx="2" fill="var(--color-mint)"/><rect x="87" y="34" width="10" height="6" rx="2" fill="var(--color-marker)" stroke="currentColor" stroke-width="1.5"/>`,
  notion: `<rect x="14" y="4" width="92" height="76" rx="6" fill="var(--color-paper)" stroke="currentColor" stroke-width="1.5"/>
    <rect x="24" y="14" width="14" height="14" rx="3" fill="var(--color-ink)"/><path d="M28 24V18l6 6v-6" stroke="var(--color-paper)" stroke-width="2"/>
    <path d="M24 38h50M24 48h62M24 58h40M24 68h56" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <rect x="80" y="34" width="16" height="8" rx="4" fill="var(--color-mint)" stroke="currentColor" stroke-width="1.5"/>`,
  sos: `<rect x="22" y="4" width="76" height="76" rx="4" fill="var(--color-paper)" stroke="currentColor" stroke-width="1.5"/>
    <path d="M34 24h40M34 36h50M34 48h30" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="86" cy="60" r="16" fill="var(--color-coral)" stroke="currentColor" stroke-width="1.5"/>
    <text x="86" y="65" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" fill="var(--color-ink)">SOS</text>`,
  worksheets: `<rect x="30" y="10" width="70" height="70" rx="4" fill="var(--color-paper-deep)" stroke="currentColor" stroke-width="1.5"/>
    <rect x="20" y="4" width="70" height="72" rx="4" fill="var(--color-paper)" stroke="currentColor" stroke-width="1.5"/>
    ${[0, 1, 2].map((r) => `<rect x="30" y="${16 + r * 18}" width="10" height="10" rx="2" fill="${r < 2 ? 'var(--color-mint)' : 'none'}" stroke="currentColor" stroke-width="1.5"/><path d="M48 ${21 + r * 18}h32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`).join('')}`,
};
---

<section id="obsah" class="relative overflow-clip py-20 sm:py-28 lg:py-36" aria-labelledby="inside-title">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-10">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="kicker mb-5" data-reveal>{i.kicker}</p>
        <h2 id="inside-title" class="display-lg max-w-[16ch]" data-reveal style="--i:1" set:html={rich(i.title)} />
        <p class="mt-6 max-w-[36rem] text-lg leading-relaxed sm:text-xl" data-reveal style="--i:2" set:html={rich(i.intro)} />
      </div>
      <div class="lg:col-span-5" data-reveal style="--i:2">
        <Book class="[--w:13rem] sm:[--w:16rem] lg:[--w:18rem]" sticker="+ bonusy" />
      </div>
    </div>

    <!-- Kapitoly jako stupnice stopek 0:00 → 5:00 -->
    <ol class="timeline mt-20 grid sm:grid-cols-2 lg:mt-28 lg:grid-cols-4">
      {
        i.chapters.map((c, n) => (
          <li class:list={['timeline-item', n === i.chapters.length - 1 && 'is-last']} data-reveal style={`--i:${n % 4}`}>
            <div class="timeline-rail" aria-hidden="true" />
            <time class="timeline-time font-mono" datetime={`PT${c.time.replace(':', 'M')}S`}>
              {c.time}
            </time>
            <div class="timeline-body">
              <h3 class="text-[1.75rem] leading-[0.95] sm:text-[2rem]" set:html={rich(c.title)} />
              <p class="mt-2.5 leading-relaxed text-ink/80" set:html={rich(c.text)} />
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Bonusy -->
    <div class="mt-24 lg:mt-32">
      <p class="kicker mb-5" data-reveal>{i.bonusesKicker}</p>
      <h3 class="display-md" data-reveal style="--i:1" set:html={rich(i.bonusesTitle)} />
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {
          i.bonuses.map((b, n) => (
            <li class="card bonus-card flex flex-col overflow-clip" data-reveal style={`--i:${n}`}>
              <div class="grid h-36 place-items-center bg-paper-deep">
                <svg class="h-24 w-auto" viewBox="0 0 120 84" fill="none" aria-hidden="true" set:html={art[b.kind]} />
              </div>
              <div class="p-5">
                <h4 class="font-display text-[1.75rem] leading-[0.95] font-extrabold [font-stretch:72%]">{b.title}</h4>
                <p class="mt-2 leading-relaxed text-ink/80" set:html={rich(b.text)} />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ---------- mobil: svislá stupnice ---------- */
  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 4.25rem 1fr;
    align-content: start;
    gap: 0 1rem;
    padding-bottom: 2.25rem;
  }
  .timeline-rail {
    position: absolute;
    left: 3.6rem;
    top: 0.4rem;
    bottom: 0;
    width: 16px;
    background:
      linear-gradient(var(--color-ink), var(--color-ink)) left / 1px 100% no-repeat,
      repeating-linear-gradient(180deg, var(--color-ink) 0 1px, transparent 1px 10px) left / 8px 100% no-repeat;
  }
  .timeline-item.is-last .timeline-rail {
    display: none;
  }
  .timeline-time {
    font-size: 1.05rem;
    font-weight: 700;
    padding-top: 0.15rem;
  }
  .timeline-body {
    position: relative;
    padding-left: 0.75rem;
  }
  .timeline-body::before {
    content: '';
    position: absolute;
    left: -2rem;
    top: 0.45rem;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: var(--color-paper);
    border: 1.5px solid var(--color-ink);
  }
  .timeline-item.is-last .timeline-body::before {
    background: var(--color-coral);
    width: 18px;
    height: 18px;
    left: -2.12rem;
  }
  .timeline-item.is-last .timeline-time {
    color: var(--color-ink);
    background: var(--color-marker);
    align-self: start;
    justify-self: start;
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
  }

  /* ---------- tablet/desktop: vodorovné pravítko ---------- */
  @media (min-width: 640px) {
    .timeline-item {
      grid-template-columns: 1fr;
      padding: 0 1.5rem 3rem 0;
    }
    .timeline-rail {
      position: static;
      width: auto;
      height: 26px;
      order: 1;
      margin-bottom: 0.9rem;
      background:
        linear-gradient(var(--color-ink), var(--color-ink)) bottom / 100% 1px no-repeat,
        repeating-linear-gradient(90deg, var(--color-ink) 0 1px, transparent 1px 12px) bottom / 100% 8px no-repeat,
        linear-gradient(var(--color-ink), var(--color-ink)) left bottom / 1px 100% no-repeat;
      margin-right: -1.5rem;
    }
    .timeline-item.is-last .timeline-rail {
      display: block;
      margin-right: 0;
      background:
        linear-gradient(var(--color-coral), var(--color-coral)) right bottom / 3px 100% no-repeat,
        linear-gradient(var(--color-ink), var(--color-ink)) bottom / 100% 1px no-repeat,
        repeating-linear-gradient(90deg, var(--color-ink) 0 1px, transparent 1px 12px) bottom / 100% 8px no-repeat,
        linear-gradient(var(--color-ink), var(--color-ink)) left bottom / 1px 100% no-repeat;
    }
    .timeline-time {
      order: 0;
      margin-bottom: 0.4rem;
    }
    .timeline-body {
      order: 2;
      padding-left: 0;
    }
    .timeline-body::before {
      display: none;
    }
  }
  .bonus-card {
    transition:
      translate 0.3s var(--ease-out-expo),
      box-shadow 0.3s;
  }
  .bonus-card:hover {
    translate: 0 -4px;
    box-shadow: var(--shadow-soft);
  }
</style>
