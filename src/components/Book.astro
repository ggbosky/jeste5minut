---
/** Obálka e-booku (čisté CSS, žádný obrázek ke stažení). */
import { getContent } from '../content';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const b = getContent().hero.book;
---

<div class:list={['book', cls]} aria-hidden="true">
  <div class="cover">
    <span class="cover-rule"></span>
    <p class="cover-title">{b.title}</p>
    <p class="cover-sub">{b.subtitle}</p>
  </div>
</div>

<style>
  .book {
    --w: 16rem;
    width: var(--w);
    margin-inline: auto;
    perspective: 1600px;
  }
  .cover {
    position: relative;
    aspect-ratio: 0.72;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-align: left;
    padding: calc(var(--w) * 0.1);
    border-radius: 4px 10px 10px 4px;
    background: var(--color-ink);
    color: #fff;
    transform: rotateY(-14deg) rotateX(4deg);
    box-shadow:
      inset 5px 0 0 rgb(255 255 255 / 0.08),
      inset 7px 0 0 rgb(0 0 0 / 0.25),
      24px 30px 50px -20px rgb(20 33 61 / 0.45),
      8px 10px 20px -10px rgb(20 33 61 / 0.3);
  }
  .cover-rule {
    position: absolute;
    top: calc(var(--w) * 0.1);
    left: calc(var(--w) * 0.1);
    width: calc(var(--w) * 0.14);
    height: 4px;
    border-radius: 2px;
    background: var(--color-coral);
  }
  .cover-title {
    font-weight: 700;
    font-size: calc(var(--w) * 0.13);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .cover-sub {
    margin-top: 0.6em;
    font-size: calc(var(--w) * 0.055);
    line-height: 1.3;
    opacity: 0.75;
  }
</style>
