---
/** 3D mockup e-booku čistě v CSS. Na desktopu se naklání za kurzorem. */
import { getContent } from '../content';

interface Props {
  class?: string;
  sticker?: string;
}
const { class: cls = '', sticker } = Astro.props;
const b = getContent().hero.book;
const [first, ...rest] = b.title.split(' 5 ');
---

<div class:list={['book-scene', cls]} data-tilt aria-hidden="true">
  <div class="book">
    <div class="book-back"></div>
    <div class="book-pages"></div>
    <div class="book-cover grain grain-dark">
      <p class="font-mono text-[0.6rem] tracking-[0.18em] uppercase opacity-70">E-book</p>
      <p class="book-title">
        {first}<br /><span class="book-five">5</span>
        {rest.join(' 5 ')}
      </p>
      <p class="mt-auto text-[0.82rem] leading-snug font-semibold opacity-90">{b.subtitle}</p>
      <div class="mt-3 flex items-center justify-between font-mono text-[0.6rem] opacity-70">
        <span>{b.pages}</span>
        <span class="book-ticks"></span>
      </div>
    </div>
  </div>
  {sticker && <span class="book-sticker">{sticker}</span>}
</div>

<style>
  .book-scene {
    --w: 15rem;
    position: relative;
    width: var(--w);
    aspect-ratio: 0.72;
    perspective: 1400px;
    margin-inline: auto;
  }
  .book {
    --rx: 6deg;
    --ry: -24deg;
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.6s var(--ease-out-expo);
  }
  .book > div {
    position: absolute;
    border: 3px solid var(--color-ink);
  }
  .book-cover {
    inset: 0;
    transform: translateZ(14px);
    background: var(--color-ink);
    color: var(--color-paper);
    border-radius: 4px 12px 12px 4px;
    padding: 1.1rem 1.1rem 1rem 1.4rem;
    display: flex;
    flex-direction: column;
    box-shadow: inset 6px 0 0 color-mix(in srgb, var(--color-paper) 14%, transparent);
  }
  .book-back {
    inset: 0;
    transform: translateZ(-14px);
    background: var(--color-ink);
    border-radius: 4px 12px 12px 4px;
    box-shadow: 14px 14px 0 var(--color-ink);
  }
  .book-pages {
    top: 6px;
    bottom: 6px;
    right: -14px;
    width: 28px;
    transform: rotateY(90deg);
    background: repeating-linear-gradient(90deg, var(--color-paper) 0 2px, var(--color-paper-deep) 2px 4px);
  }
  .book-title {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(var(--w) * 0.19);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }
  .book-five {
    display: inline-grid;
    place-items: center;
    padding: 0 0.1em;
    margin-top: 0.08em;
    font-family: var(--font-mono);
    color: var(--color-ink);
    background: var(--color-coral);
    border: 3px solid var(--color-paper);
    border-radius: 0.14em;
    rotate: -5deg;
  }
  .book-ticks {
    width: 40%;
    height: 8px;
    background: repeating-linear-gradient(90deg, currentColor 0 1.5px, transparent 1.5px 6px);
  }
  .book-sticker {
    position: absolute;
    right: -1.2rem;
    top: 12%;
    z-index: 2;
    padding: 0.5rem 0.8rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1;
    background: var(--color-marker);
    border: 3px solid var(--color-ink);
    border-radius: 999px;
    box-shadow: var(--shadow-hard-sm);
    rotate: 10deg;
  }
</style>

<script>
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !calm) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((scene) => {
      const book = scene.querySelector<HTMLElement>('.book')!;
      const zone = scene.closest('section') ?? scene;
      zone.addEventListener('pointermove', (e) => {
        const r = scene.getBoundingClientRect();
        const x = ((e as PointerEvent).clientX - (r.left + r.width / 2)) / innerWidth;
        const y = ((e as PointerEvent).clientY - (r.top + r.height / 2)) / innerHeight;
        book.style.setProperty('--ry', `${-24 + x * 30}deg`);
        book.style.setProperty('--rx', `${6 - y * 16}deg`);
      });
      zone.addEventListener('pointerleave', () => {
        book.style.removeProperty('--ry');
        book.style.removeProperty('--rx');
      });
    });
  }
</script>
