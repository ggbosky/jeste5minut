---
import { getContent } from '../content';

const { marquee: quotes, marqueeLabel } = getContent();
---

<section class="marquee relative overflow-clip bg-ink py-5 text-paper sm:py-6" aria-label={marqueeLabel}>
  <div class="flex w-max animate-marquee motion-reduce:animate-none">
    {
      [0, 1].map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {quotes.map((q) => (
            <li class="flex items-center text-lg whitespace-nowrap text-paper/85 sm:text-xl">
              <span class="px-6 sm:px-9">{q}</span>
              <span class="size-1.5 rounded-full bg-coral" aria-hidden="true" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .marquee:hover .animate-marquee {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee > div {
      width: auto;
      overflow-x: auto;
    }
  }
</style>
