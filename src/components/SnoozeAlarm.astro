---
import { getContent } from '../content';

const a = getContent().hero.alarm;
---

<div class="snooze hero-in" style="--i:3" data-time={a.time} data-reactions={JSON.stringify(a.reactions)}>
  <div class="flex items-center justify-between font-mono text-xs tracking-wide text-ink/75 uppercase">
    <span class="flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="13" r="7.5" stroke="currentColor" stroke-width="2"></circle>
        <path d="M12 9.5V13l2.5 1.6M4 5.5 6.5 3M20 5.5 17.5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      {a.appTitle}
    </span>
    <span>{a.day}</span>
  </div>

  <p class="time" data-snooze-time aria-hidden="true">{a.time}</p>
  <p class="text-lg font-medium">{a.label}</p>

  <button type="button" class="snooze-btn" data-snooze-btn aria-describedby="snooze-status">
    <span data-snooze-text>{a.snooze}</span>
  </button>

  <div class="mt-4 flex items-center justify-between text-[0.9375rem]">
    <a href="#cena" class="link font-medium" data-track="alarm_stop">{a.stop} →</a>
    <span class="font-mono text-xs text-ink/75" aria-hidden="true">{a.counter} <span data-snooze-count>0</span>×</span>
  </div>
  <p id="snooze-status" class="sr-only" aria-live="polite" data-snooze-live></p>
</div>

<style>
  .snooze {
    max-width: 28rem;
    margin-inline: auto;
    padding: 1.5rem;
    border-radius: 28px;
    background: var(--color-paper-deep);
  }
  @media (min-width: 640px) {
    .snooze {
      padding: 2rem 2.25rem;
    }
  }
  .time {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 72%;
    font-size: clamp(6.5rem, 34vw, 10rem);
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }
  .snooze-btn {
    width: 100%;
    margin-top: 1.75rem;
    min-height: 4rem;
    border-radius: 999px;
    background: var(--color-coral);
    color: var(--color-ink);
    font-weight: 600;
    font-size: 1.2rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.15s ease,
      background-color 0.3s,
      translate 0.45s var(--ease-out-expo);
  }
  .snooze-btn:hover {
    background: #ee4a27;
  }
  .snooze-btn:active {
    transform: scale(0.98);
  }
  .snooze-btn.is-done {
    background: var(--color-mint);
  }
  /* budík zazvoní */
  .snooze.is-ringing .time {
    animation: buzz 0.4s linear;
  }
  @keyframes buzz {
    0%,
    100% {
      transform: none;
    }
    20%,
    60% {
      transform: translateX(-3px);
    }
    40%,
    80% {
      transform: translateX(3px);
    }
  }
  .time.is-flip {
    animation: flip 0.4s var(--ease-out-expo);
  }
  @keyframes flip {
    from {
      transform: translateY(-8%);
      opacity: 0.2;
    }
  }
</style>

<script>
  import { track } from '../lib/analytics';
  import { scrollToId } from '../lib/scroll';

  const root = document.querySelector<HTMLElement>('.snooze');
  const btn = root?.querySelector<HTMLButtonElement>('[data-snooze-btn]');

  if (root && btn) {
    const text = root.querySelector<HTMLElement>('[data-snooze-text]')!;
    const time = root.querySelector<HTMLElement>('[data-snooze-time]')!;
    const count = root.querySelector<HTMLElement>('[data-snooze-count]')!;
    const live = root.querySelector<HTMLElement>('[data-snooze-live]')!;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const reactions: string[] = JSON.parse(root.dataset.reactions || '[]');
    const [hh, mm] = (root.dataset.time || '23:55').split(':').map(Number);
    let minutes = hh * 60 + mm;
    let clicks = 0;
    const last = reactions.length;

    const goToOffer = () => scrollToId('cena');

    btn.addEventListener('click', () => {
      if (clicks >= last) return goToOffer();
      clicks++;
      minutes = (minutes + 5) % (24 * 60);
      time.textContent = `${String(Math.floor(minutes / 60)).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`;
      time.classList.remove('is-flip');
      void time.offsetWidth; // restart animace
      time.classList.add('is-flip');
      count.textContent = String(clicks);

      const msg = reactions[clicks - 1];
      text.textContent = msg;
      live.textContent = msg;
      navigator.vibrate?.(clicks === last ? [30, 60, 30] : 25);

      if (clicks < last) {
        root.classList.remove('is-ringing');
        void root.offsetWidth;
        root.classList.add('is-ringing');
        // tlačítko kousek uhne – pokaždé na druhou stranu, ale zůstane klikatelné
        if (!calm) btn.style.translate = `${clicks % 2 ? 12 : -12}px 0`;
      } else {
        btn.style.translate = '';
        btn.classList.add('is-done');
        track('snooze_complete');
        setTimeout(goToOffer, calm ? 300 : 900);
      }
    });
  }
</script>
