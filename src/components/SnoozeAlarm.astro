---
import { getContent } from '../content';

const a = getContent().hero.alarm;
---

<div
  class="snooze hero-in relative mx-auto w-full"
  style="--i:3"
  data-time={a.time}
  data-reactions={JSON.stringify(a.reactions)}
>
  <!-- Zamčený telefon ve 23:55 – budík, který chceš odložit -->
  <div class="phone" data-snooze-card role="group" aria-label={a.lockLabel}>
    <div class="screen text-paper">
      <div class="status font-sans" aria-hidden="true">
        <span class="island"></span>
        <span class="status-right">
          <svg width="17" height="11" viewBox="0 0 17 11" fill="currentColor">
            <rect x="0" y="7" width="3" height="4" rx="1"></rect><rect x="4.5" y="5" width="3" height="6" rx="1"></rect><rect x="9" y="2.5" width="3" height="8.5" rx="1"></rect><rect x="13.5" y="0" width="3" height="11" rx="1" opacity=".35"></rect>
          </svg>
          <span class="battery-label">{a.battery}</span>
          <span class="battery"><span></span></span>
        </span>
      </div>

      <svg class="lock" width="14" height="18" viewBox="0 0 14 18" fill="none" aria-hidden="true">
        <rect x="1" y="7.5" width="12" height="9.5" rx="2.5" fill="currentColor"></rect>
        <path d="M3.5 7.5V5a3.5 3.5 0 0 1 7 0v2.5" stroke="currentColor" stroke-width="1.8"></path>
      </svg>
      <p class="date">{a.day}</p>
      <p class="time" data-snooze-time aria-hidden="true">{a.time}</p>

      <ul class="notes" aria-hidden="true">
        {
          a.notifications.map((n) => (
            <li class="note">
              <span class="note-head">
                <span class="note-app">{n.app}</span>
                <span class="note-ago">{n.ago}</span>
              </span>
              <span class="note-text">{n.text}</span>
            </li>
          ))
        }
      </ul>

      <div class="alarm">
        <div class="alarm-head">
          <span class="alarm-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="13" r="7.5" stroke="currentColor" stroke-width="2.2"></circle>
              <path d="M12 9.5V13l2.5 1.6M4 5.5 6.5 3M20 5.5 17.5 3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="alarm-title">{a.appTitle}</span>
          <span class="alarm-count font-mono" aria-hidden="true">{a.counter} <span data-snooze-count>0</span>×</span>
        </div>
        <p class="alarm-label">{a.label}</p>

        <button type="button" class="snooze-btn" data-snooze-btn aria-describedby="snooze-status">
          <span data-snooze-text>{a.snooze}</span>
        </button>
        <a href="#cena" class="stop-btn" data-track="alarm_stop">{a.stop}</a>
      </div>

      <span class="home" aria-hidden="true"></span>
      <p id="snooze-status" class="sr-only" aria-live="polite" data-snooze-live></p>
    </div>
  </div>
</div>

<style>
  .snooze {
    --w: min(19rem, 82vw);
    width: var(--w);
  }
  @media (min-width: 1024px) {
    .snooze {
      --w: 21rem;
    }
  }
  .phone {
    position: relative;
    aspect-ratio: 9 / 18.6;
    padding: 0.55rem;
    border-radius: calc(var(--w) * 0.16);
    background: #0c1426;
    box-shadow:
      inset 0 0 0 1.5px #2a3550,
      inset 0 0 0 4px #0c1426,
      var(--shadow-lift),
      0 40px 80px -40px rgb(20 33 61 / 0.55);
  }
  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--w) * 0.13);
    padding: 0.9rem 0.9rem 0.7rem;
    background:
      radial-gradient(120% 60% at 50% 0%, #24335a 0%, transparent 70%),
      radial-gradient(90% 50% at 80% 100%, rgb(255 90 54 / 0.22) 0%, transparent 70%),
      var(--color-ink);
  }
  .status {
    position: relative;
    width: 100%;
    height: 1.6rem;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .island {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% 0;
    width: 32%;
    height: 1.55rem;
    border-radius: 999px;
    background: #05080f;
  }
  .status-right {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-right: 0.35rem;
  }
  .battery {
    position: relative;
    width: 1.45rem;
    height: 0.72rem;
    border: 1.5px solid rgb(250 247 240 / 0.5);
    border-radius: 0.25rem;
    padding: 1.5px;
  }
  .battery::after {
    content: '';
    position: absolute;
    right: -3.5px;
    top: 50%;
    translate: 0 -50%;
    width: 2px;
    height: 4px;
    border-radius: 0 2px 2px 0;
    background: rgb(250 247 240 / 0.5);
  }
  .battery span {
    display: block;
    width: 18%;
    height: 100%;
    border-radius: 1px;
    background: var(--color-coral);
  }
  .battery-label {
    font-variant-numeric: tabular-nums;
    opacity: 0.85;
  }
  .lock {
    margin-top: 1.1rem;
    opacity: 0.85;
  }
  .date {
    margin-top: 0.6rem;
    font-size: calc(var(--w) * 0.058);
    font-weight: 500;
    opacity: 0.85;
  }
  .time {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: calc(var(--w) * 0.3);
    line-height: 0.95;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .notes {
    width: 100%;
    margin-top: auto;
    display: grid;
    gap: 0.4rem;
    padding-top: 0.8rem;
  }
  .note {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.75rem;
    border-radius: 1rem;
    background: rgb(250 247 240 / 0.08);
    font-size: 0.75rem;
    line-height: 1.3;
  }
  .note-head {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-weight: 600;
  }
  .note-ago {
    font-weight: 400;
    opacity: 0.55;
  }
  .note-text {
    opacity: 0.8;
  }
  @media (max-width: 380px) {
    .note:nth-child(n + 3) {
      display: none;
    }
  }
  .alarm {
    margin-top: 0.6rem;
    width: 100%;
    padding: 0.85rem;
    border-radius: 1.4rem;
    background: rgb(250 247 240 / 0.1);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .alarm-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    opacity: 0.75;
  }
  .alarm-icon {
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 0.4rem;
    background: var(--color-coral);
    color: var(--color-ink);
  }
  .alarm-count {
    margin-left: auto;
    font-size: 0.6875rem;
  }
  .alarm-label {
    margin-top: 0.35rem;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.25;
  }
  .snooze-btn {
    width: 100%;
    margin-top: 0.85rem;
    min-height: 3.6rem;
    border-radius: 999px;
    background: var(--color-coral);
    color: var(--color-ink);
    font-weight: 700;
    font-size: 1.15rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.15s ease,
      background-color 0.3s,
      translate 0.45s var(--ease-out-expo);
  }
  .snooze-btn:hover {
    background: #ee4a27;
  }
  .snooze-btn:active {
    transform: scale(0.97);
  }
  .snooze-btn.is-done {
    background: var(--color-mint);
  }
  .stop-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    min-height: 2.75rem;
    border-radius: 999px;
    background: rgb(250 247 240 / 0.12);
    font-weight: 600;
    font-size: 0.9375rem;
    transition: background-color 0.2s;
  }
  .stop-btn:hover {
    background: rgb(250 247 240 / 0.22);
  }
  .home {
    margin-top: 0.7rem;
    width: 36%;
    height: 4px;
    border-radius: 999px;
    background: rgb(250 247 240 / 0.7);
    flex-shrink: 0;
  }
  /* telefon zabzučí */
  .snooze.is-ringing .phone {
    animation: buzz 0.4s linear;
  }
  @keyframes buzz {
    0%,
    100% {
      transform: none;
    }
    20%,
    60% {
      transform: translateX(-3px);
    }
    40%,
    80% {
      transform: translateX(3px);
    }
  }
  .time.is-flip {
    animation: flip 0.4s var(--ease-out-expo);
  }
  @keyframes flip {
    from {
      transform: translateY(-10%);
      opacity: 0.2;
    }
  }
</style>

<script>
  import { track } from '../lib/analytics';
  import { scrollToId } from '../lib/scroll';

  const root = document.querySelector<HTMLElement>('.snooze');
  const btn = root?.querySelector<HTMLButtonElement>('[data-snooze-btn]');

  if (root && btn) {
    const text = root.querySelector<HTMLElement>('[data-snooze-text]')!;
    const time = root.querySelector<HTMLElement>('[data-snooze-time]')!;
    const count = root.querySelector<HTMLElement>('[data-snooze-count]')!;
    const live = root.querySelector<HTMLElement>('[data-snooze-live]')!;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const reactions: string[] = JSON.parse(root.dataset.reactions || '[]');
    const [hh, mm] = (root.dataset.time || '23:55').split(':').map(Number);
    let minutes = hh * 60 + mm;
    let clicks = 0;
    const last = reactions.length;

    const goToOffer = () => scrollToId('cena');

    const ring = () => {
      root.classList.remove('is-ringing');
      void root.offsetWidth; // restart animace
      root.classList.add('is-ringing');
    };

    btn.addEventListener('click', () => {
      if (clicks >= last) return goToOffer();
      clicks++;
      minutes = (minutes + 5) % (24 * 60);
      time.textContent = `${String(Math.floor(minutes / 60)).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`;
      time.classList.remove('is-flip');
      void time.offsetWidth;
      time.classList.add('is-flip');
      count.textContent = String(clicks);

      const msg = reactions[clicks - 1];
      text.textContent = msg;
      live.textContent = msg;
      navigator.vibrate?.(clicks === last ? [30, 60, 30] : 25);

      if (clicks < last) {
        ring();
        // tlačítko kousek uhne – pokaždé na druhou stranu, ale zůstane klikatelné
        if (!calm) btn.style.translate = `${clicks % 2 ? 14 : -14}px 0`;
      } else {
        btn.style.translate = '';
        btn.classList.add('is-done');
        track('snooze_complete');
        setTimeout(goToOffer, calm ? 300 : 900);
      }
    });
  }
</script>
