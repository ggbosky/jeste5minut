---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Reframe from '../components/Reframe.astro';
import Quiz from '../components/Quiz.astro';
import LeadSection from '../components/LeadSection.astro';
import Inside from '../components/Inside.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import Guarantee from '../components/Guarantee.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import MiniTimer from '../components/MiniTimer.astro';
import TimerDivider from '../components/TimerDivider.astro';
---

<Base productSchema>
  <Nav />
  <main id="main">
    <Hero />
    <div class="cv-host">
    <Marquee />
    <div class="-mt-8 bg-ink pt-8"><Reframe /></div>
    <Quiz />
    <TimerDivider label="1:00" />
    <LeadSection />
    <TimerDivider label="2:30" />
    <Inside />
    <HowItWorks />
    <Testimonials />
    <Pricing />
    <Guarantee />
    <Faq />
    <FinalCta />
    </div>
  </main>
  <Footer />
  <MiniTimer />
</Base>
