---
import Base from '../layouts/Base.astro';
import { getContent } from '../content';

const t = getContent().notFound;
---

<Base title={`${t.title} – Ještě 5 minut`} description={t.text} noindex>
  <main id="main" class="container-page flex min-h-[100svh] flex-col items-center justify-center text-center">
    <p class="text-sm font-semibold text-muted">404</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">{t.title}</h1>
    <p class="mt-4 text-lg text-muted">{t.text}</p>
    <a href="/" class="btn mt-8">{t.cta}</a>
  </main>
</Base>
