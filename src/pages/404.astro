---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { getContent } from '../content';
import { rich } from '../lib/rich';

const t = getContent().notFound;
---

<Base title={`404 – ${t.title}`} description={t.text} noindex>
  <main id="main" class="grain flex min-h-[100svh] flex-col justify-between px-4 py-8 sm:px-10 sm:py-10">
    <a href="/" class="text-2xl" aria-label="Ještě 5 minut"><Logo /></a>
    <div class="max-w-[60rem]">
      <p class="font-display text-[clamp(6rem,30vw,16rem)] leading-[0.8] font-bold tracking-[-0.06em]" aria-hidden="true">4<span class="hero-five">0</span>4</p>
      <h1 class="display-md mt-8" set:html={rich(t.title)} />
      <p class="mt-5 text-xl leading-relaxed" set:html={rich(t.text)} />
      <a href="/" class="btn btn-lg btn-coral mt-8">{t.cta}</a>
    </div>
    <span></span>
  </main>
</Base>
