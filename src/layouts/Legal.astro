---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../content';
import type { LegalPage } from '../content/types';
import { rich } from '../lib/rich';

interface Props {
  page: LegalPage;
}
const { page } = Astro.props;
const t = getContent();
---

<Base title={`${page.title} – Ještě 5 minut`} description={page.description}>
  <header class="border-b border-line">
    <div class="container-page flex h-14 items-center justify-between">
      <a href="/" class="font-semibold tracking-tight" aria-label={t.nav.logoLabel}>Ještě 5 minut</a>
      <a href="/" class="link text-sm">{t.legal.back}</a>
    </div>
  </header>
  <main id="main" class="py-16 sm:py-24">
    <article class="container-page max-w-[44rem]">
      <h1 class="text-4xl sm:text-5xl">{page.title}</h1>
      <p class="mt-3 text-sm text-muted">{t.legal.updatedLabel}: {page.updated}</p>
      <!-- TODO: právní text je šablona – doplň v src/content/cs.ts → legal -->
      <p class="mt-8 rounded-xl bg-soft px-4 py-3 text-[0.9375rem]">{t.legal.placeholderNote}</p>
      {
        page.sections.map((s) => (
          <section class="mt-10">
            <h2 class="text-2xl">{s.heading}</h2>
            {s.body.map((para) => (
              <p class="mt-4 text-lg leading-relaxed" set:html={rich(para)} />
            ))}
          </section>
        ))
      }
    </article>
  </main>
  <Footer />
</Base>
